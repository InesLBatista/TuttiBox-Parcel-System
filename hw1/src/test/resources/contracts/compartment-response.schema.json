{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compartment-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "code", "stationCode", "size", "status"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "stationCode": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "string",
      "enum": ["S", "M", "L"]
    },
    "status": {
      "type": "string",
      "enum": ["FREE", "RESERVED", "OCCUPIED", "OUT_OF_SERVICE"]
    }
  }
}
