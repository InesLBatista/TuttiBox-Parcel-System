{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "status", "error", "message"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  }
}
