{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuttibox.example/schemas/nearby-station.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "latitude",
    "longitude",
    "distanceKm",
    "availableSmall",
    "availableMedium",
    "availableLarge"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "distanceKm": {
      "type": "number",
      "minimum": 0
    },
    "availableSmall": {
      "type": "integer",
      "minimum": 0
    },
    "availableMedium": {
      "type": "integer",
      "minimum": 0
    },
    "availableLarge": {
      "type": "integer",
      "minimum": 0
    }
  }
}
